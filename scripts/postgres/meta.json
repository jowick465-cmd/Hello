{
  "name": "postgres-db",
  "displayName": "PostgreSQL",
  "description": "PostgreSQL 16 relational database with a default app database and user.",
  "category": "database",
  "tags": ["postgresql", "sql", "relational", "rdbms"],
  "ports": { "5432": "5432" },
  "volumes": ["postgres-data:/var/lib/postgresql/data"],
  "environment": {
    "POSTGRES_USER": "appuser",
    "POSTGRES_PASSWORD": "apppassword",
    "POSTGRES_DB": "appdb"
  }
}
